<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ goal.title }} — Помогай</title>
    <link rel="stylesheet" href="/static/style.css?v=4">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', -apple-system, sans-serif; background: #FDF8F5; color: #2D2D2D; padding-bottom: 40px; }
        .container { max-width: 500px; margin: 0 auto; padding: 0; }

        /* Шапка */
        .goal-header {
            background: linear-gradient(160deg, #FF5A3C 0%, #FF7B5C 35%, #E85D75 100%);
            padding: 20px 16px 18px;
            color: white;
            border-radius: 0;
            border-bottom: 3px solid #FF8C69;
            box-shadow: 0 2px 8px rgba(255,107,74,0.15);
            position: relative;
            overflow: hidden;
        }
        .goal-header::after {
            content: '';
            position: absolute;
            top: -30px; right: -30px;
            width: 80px; height: 80px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
        }
        .goal-header::before {
            content: '';
            position: absolute;
            bottom: -15px; left: 15px;
            width: 40px; height: 40px;
            background: rgba(255,255,255,0.06);
            border-radius: 50%;
        }
        .goal-header h1 { font-size: 22px; font-weight: 700; }
        .goal-header .author-row { display: flex; align-items: center; gap: 10px; margin-top: 8px; font-size: 14px; opacity: 0.85; }
        .goal-header .avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; flex-shrink: 0;
        }

        /* Контент */
        .content { padding: 20px 16px; }
        /* Галерея фото */
        .gallery { margin-bottom: 20px; }
        .gallery-hero {
            width: 100%;
            aspect-ratio: 4 / 3;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            cursor: pointer;
            background: #F5F5F5;
            position: relative;
        }
        .gallery-hero-img {
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
        .gallery-counter {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(0,0,0,0.6);
            color: white;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 8px;
            backdrop-filter: blur(4px);
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }
        .gallery-thumbs {
            display: flex;
            gap: 8px;
            margin-top: 8px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding-bottom: 4px;
        }
        .gallery-thumbs::-webkit-scrollbar { display: none; }
        .gallery-thumb {
            flex: 0 0 72px;
            width: 72px;
            height: 72px;
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: border-color 0.15s, transform 0.1s;
            background: #F5F5F5;
        }
        .gallery-thumb:active { transform: scale(0.95); }
        .gallery-thumb.active { border-color: #FF5A3C; }
        .gallery-thumb-img {
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Кастомный чекбокс "Помочь анонимно" */
        .anon-check-wrap {
            display: flex;
            align-items: center;
            cursor: pointer;
            user-select: none;
            -webkit-user-select: none;
            padding: 4px 0;
        }
        .anon-check-wrap input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }
        .anon-check-box {
            width: 24px;
            height: 24px;
            border: 2px solid #D0D0D0;
            border-radius: 8px;
            background: white;
            margin-right: 12px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            position: relative;
        }
        .anon-check-box::after {
            content: '';
            width: 6px;
            height: 12px;
            border: solid white;
            border-width: 0 2.5px 2.5px 0;
            transform: rotate(45deg) scale(0);
            transition: transform 0.15s;
            margin-top: -2px;
        }
        .anon-check-wrap input[type="checkbox"]:checked ~ .anon-check-box {
            background: #5B9A6B;
            border-color: #5B9A6B;
            box-shadow: 0 2px 8px rgba(91,154,107,0.25);
        }
        .anon-check-wrap input[type="checkbox"]:checked ~ .anon-check-box::after {
            transform: rotate(45deg) scale(1);
        }
        .anon-check-wrap input[type="checkbox"]:active ~ .anon-check-box {
            transform: scale(0.95);
        }
        .anon-check-label {
            font-size: 15px;
            color: #2D2D2D;
            font-weight: 500;
        }

        /* Защита фото */
        .gallery-hero,
        .gallery-thumb {
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        /* Лайтбокс */
        .lightbox {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.95);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .lightbox.active { display: flex; }
        .lightbox-img-wrap {
            max-width: 100%;
            max-height: 100%;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }
        .lightbox-img-view {
            max-width: 100%;
            max-height: 100%;
            width: 90vw;
            height: 85vh;
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
            pointer-events: none;
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            user-select: none;
        }
        .lightbox-close {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            color: white;
            border: none;
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: sans-serif;
        }
        .lightbox-close:active { background: rgba(255,255,255,0.3); }
        .lightbox-nav {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            color: white;
            border: none;
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: sans-serif;
        }
        .lightbox-nav:active { background: rgba(255,255,255,0.3); }
        .lightbox-prev { left: 16px; }
        .lightbox-next { right: 16px; }
        .lightbox-counter {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            font-size: 14px;
            font-weight: 600;
            background: rgba(0,0,0,0.5);
            padding: 6px 14px;
            border-radius: 10px;
        }

        /* Карточка со статистикой */
        .stats-card {
            background: white;
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            margin-bottom: 16px;
        }
        .stats-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .stats-row .collected { font-size: 28px; font-weight: 700; color: #2D2D2D; }
        .stats-row .goal { font-size: 14px; color: #8C7A6B; }
        .stats-row .goal span { font-weight: 600; color: #2D2D2D; }
        .progress-bar { background: #F0F0F0; border-radius: 8px; height: 10px; overflow: hidden; margin-bottom: 8px; }
        .progress-fill { background: linear-gradient(90deg, #5B9A6B, #7BC67E); height: 100%; border-radius: 8px; transition: width 0.4s ease; }
        .stats-meta { display: flex; justify-content: space-between; font-size: 13px; color: #8C7A6B; }
        .stats-meta span { display: flex; align-items: center; gap: 4px; }
        .deadline { font-size: 13px; color: #E57373; margin-top: 4px; }

        /* Описание */
        .description { font-size: 15px; line-height: 1.6; color: #2D2D2D; margin-bottom: 20px; white-space: pre-wrap; }

        /* Список донатов */
        .donations-title { font-size: 17px; font-weight: 700; margin-bottom: 12px; color: #2D2D2D; }
        .donation-item {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 0; border-bottom: 1px solid #F0EDEA;
        }
        .donation-item:last-child { border-bottom: none; }
        .donation-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: #F0EDEA; display: flex; align-items: center; justify-content: center;
            font-size: 14px; font-weight: 600; color: #8C7A6B; flex-shrink: 0;
        }
        .donation-info { flex: 1; }
        .donation-info .donor-name { font-size: 14px; font-weight: 600; color: #2D2D2D; }
        .donation-info .donor-meta { font-size: 12px; color: #8C7A6B; }
        .donation-amount { font-size: 16px; font-weight: 700; color: #2D2D2D; }
        .warm-word { font-size: 13px; color: #8C7A6B; font-style: italic; margin-top: 2px; }
        .confirm-btn {
            background: #5B9A6B; color: white; border: none;
            padding: 8px 14px; border-radius: 8px; cursor: pointer;
            font-size: 13px; font-weight: 600; white-space: nowrap;
        }
        .confirm-btn:active { transform: scale(0.97); }

        /* Кнопки */
        .btn-help {
            display: block; width: 100%;
            padding: 16px;
            background: linear-gradient(160deg, #FF5A3C 0%, #FF7B5C 35%, #E85D75 100%);
            color: white; border: none; border-radius: 14px;
            font-size: 18px; font-weight: 600; cursor: pointer;
            box-shadow: 0 2px 8px rgba(255,107,74,0.15);
            transition: transform 0.1s; margin-top: 12px;
            position: relative; overflow: hidden;
        }
        .btn-help::after {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 60%);
            opacity: 0; transition: opacity 0.3s;
        }
        .btn-help:active::after { opacity: 1; }
        .btn-help:active { transform: scale(0.97); }

        .btn-back {
            display: block; width: 100%;
            padding: 14px; text-align: center;
            border: 1px solid #FF5A3C; color: #FF5A3C;
            background: white; border-radius: 14px;
            font-size: 15px; font-weight: 600; cursor: pointer;
            text-decoration: none; margin-top: 8px;
            transition: transform 0.1s;
        }
        .btn-back:active { transform: scale(0.97); }

        /* Модальное окно */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 100; justify-content: center; align-items: flex-end; }
        .modal.active { display: flex; }
        .modal-content { background: white; border-radius: 20px 20px 0 0; padding: 24px; width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; position: relative; }
        .modal-close { position: absolute; top: 14px; right: 16px; font-size: 22px; cursor: pointer; color: #999; }
        .amount-btn { display: block; width: 100%; padding: 16px; margin: 10px 0; border: 2px solid #E0E0E0; border-radius: 14px; font-size: 18px; font-weight: 700; background: white; cursor: pointer; color: #2D2D2D; transition: border-color 0.2s; }
        .amount-btn:hover, .amount-btn:active { border-color: #FF5A3C; }
        .amount-btn.selected { border-color: #FF5A3C; background: #FFF5F2; }
        .donate-submit { display: none; width: 100%; padding: 16px; background: linear-gradient(160deg, #FF5A3C 0%, #FF7B5C 35%, #E85D75 100%); color: white; border: none; border-radius: 14px; font-size: 18px; font-weight: 600; cursor: pointer; margin-top: 10px; box-shadow: 0 2px 8px rgba(255,107,74,0.15); }
        .donate-submit.active { display: block; }
        .donate-submit:active { transform: scale(0.97); }
        .confirm-submit {
            width: 100%;
            padding: 16px;
            background: #5B9A6B;
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 2px 8px rgba(91,154,107,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .confirm-submit:active { transform: scale(0.97); }
        .confirm-submit {
            width: 100%;
            padding: 16px;
            background: #5B9A6B;
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 2px 8px rgba(91,154,107,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .confirm-submit:active { transform: scale(0.97); }
        .manual-mode { display: none; margin-top: 16px; text-align: left; }
        .manual-mode.active { display: block; }
        .row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #F0EDEA;
            gap: 12px;
        }
        .row:last-child { border-bottom: none; }
        .row .label { color: #8C7A6B; font-size: 14px; flex-shrink: 0; }
        .row .value { font-weight: 600; font-size: 15px; color: #2D2D2D; text-align: right; word-break: break-word; }
        .row .value-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }
        .copy-btn { background: #F8F9FC; border: 1px solid #E0E0E0; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-size: 14px; }
        .copy-btn:active { background: #F0EDEA; }
        .explain { font-size: 12px; color: #8C7A6B; margin-top: 8px; }

        /* Flash */
        .flash { padding: 12px 16px; border-radius: 12px; margin-bottom: 12px; font-size: 14px; }
        .flash-success { background: #d4edda; color: #155724; }
        .flash-danger { background: #f8d7da; color: #721c24; }
    @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
<script src="https://unpkg.com/feather-icons"></script>
</head>
<body>
    <div class="container">
        <script id="toast-data" type="application/json">[{% with messages = get_flashed_messages(with_categories=true) %}{% if messages %}{% for category, message in messages %}{"category":{{ category|tojson }},"text":{{ message|tojson }}}{% if not loop.last %},{% endif %}{% endfor %}{% endif %}{% endwith %}]</script>

        <!-- Шапка -->
        <div class="goal-header">
            <h1>{{ goal.title }}</h1>
            <div class="author-row">
                <div class="avatar">🐱</div>
                <span>{{ author.name or 'Аноним' }}</span>
            </div>
        </div>

        <div class="content">
            {% if photos_list %}
            <div class="gallery" id="gallery" data-photos='{{ photos_list | tojson }}'>
                <div class="gallery-hero" onclick="openLightbox(currentIndex)">
                    <div id="galleryHero" class="gallery-hero-img" style="background-image: url('{{ photos_list[0] }}');" oncontextmenu="return false;"></div>
                    {% if photos_list | length > 1 %}
                    <div class="gallery-counter" id="galleryCounter">1 / {{ photos_list | length }}</div>
                    {% endif %}
                </div>
                {% if photos_list | length > 1 %}
                <div class="gallery-thumbs">
                    {% for photo in photos_list %}
                    <div class="gallery-thumb {% if loop.index0 == 0 %}active{% endif %}" onclick="selectPhoto({{ loop.index0 }})">
                        <div class="gallery-thumb-img" style="background-image: url('{{ photo }}');"></div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endif %}

            <!-- Карточка статистики -->
            <div class="stats-card">
                <div class="stats-row">
                    <div>
                        <div class="collected">{{ "%.0f"|format(goal.amount_collected) }} ₽</div>
                        <div class="goal">из <span>{{ "%.0f"|format(goal.amount_goal) }} ₽</span></div>
                    </div>
                    <div style="text-align:right;">
                        <div style="font-size:24px;font-weight:700;color:#2D2D2D;">{{ progress }}%</div>
                    </div>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: {{ progress }}%;"></div>
                </div>
                <div class="stats-meta">
                    {% if donor_count > 0 %}
                    <span>🤝 {{ donor_count }} чел.</span>
                    {% endif %}
                    {% if last_donation %}
                    
                    {% endif %}
                </div>
                {% if goal.status == "active" %}<div class="deadline" style="color:#5B9A6B;">Активен до {{ ends_at_formatted }}</div>{% else %}<div class="deadline" style="color:#E57373;">Не активен</div>{% endif %}
            </div>

            {% if goal.description %}
            <div class="description">{{ goal.description }}</div>
            {% endif %}

            <!-- Кнопка Помочь -->
            {% if not is_author %}
            <button class="btn-help" onclick="openModal()">Помочь</button>
            {% endif %}

            
            <!-- Модальное окно жалобы -->
            <div class="modal" id="reportModal">
                <div class="modal-content" style="padding:24px 16px 20px;">
                    <span class="modal-close" onclick="closeReportModal()" style="font-size:24px;top:10px;right:14px;">&times;</span>
                    <h3 class="modal-title">Что не так?</h3>
                    <p class="modal-subtitle">Анонимно. Помогает сделать платформу безопаснее.</p>
                    <form method="POST" action="/report/{{ goal.id }}" id="reportForm">
                        <input type="hidden" name="reason" id="reportReason">
                        <div class="tile-group">
                            <button type="button" class="tile" data-reason="Мошенничество" onclick="selectReason(this)">
                                <span class="tile-icon">⚠️</span><span class="tile-label">Мошенничество</span><span class="tile-hint">Обман, фейк</span>
                            </button>
                            <button type="button" class="tile" data-reason="Спам" onclick="selectReason(this)">
                                <span class="tile-icon">📢</span><span class="tile-label">Спам или реклама</span><span class="tile-hint">Ссылки, каналы</span>
                            </button>
                            <button type="button" class="tile" data-reason="Оскорбления" onclick="selectReason(this)">
                                <span class="tile-icon">💬</span><span class="tile-label">Оскорбления</span><span class="tile-hint">Лексика, унижения</span>
                            </button>
                            <button type="button" class="tile" data-reason="Запрещённый контент" onclick="selectReason(this)">
                                <span class="tile-icon">🚫</span><span class="tile-label">Запрещённый контент</span><span class="tile-hint">Наркотики, оружие</span>
                            </button>
                            <button type="button" class="tile" data-reason="Другое" onclick="selectReason(this)">
                                <span class="tile-icon">📝</span><span class="tile-label">Другое</span><span class="tile-hint">Что-то ещё</span>
                            </button>
                        </div>
                        <button type="submit" id="reportSubmit" disabled class="btn-cta btn-disabled" style="width:100%;">Отправить</button>
                    </form>
                </div>
            </div>


            <script>
                function openReportModal() {
                    document.body.style.overflow = 'hidden';
                    document.getElementById('reportModal').classList.add('active');
                    document.querySelectorAll('.tile').forEach(t => t.classList.remove('selected'));
                    document.getElementById('reportReason').value = '';
                    var btn = document.getElementById('reportSubmit');
                    btn.disabled = true;
                    btn.classList.add('btn-disabled');
                }
                function closeReportModal() {
                    document.getElementById('reportModal').classList.remove('active');
                    document.body.style.overflow = '';
                }
                function selectReason(el) {
                    document.querySelectorAll('.tile').forEach(t => t.classList.remove('selected'));
                    el.classList.add('selected');
                    document.getElementById('reportReason').value = el.dataset.reason;
                    var btn = document.getElementById('reportSubmit');
                    btn.disabled = false;
                    btn.classList.remove('btn-disabled');
                }
                document.getElementById('reportModal').addEventListener('click', function(e) {
                    if (e.target === this) closeReportModal();
                });
            </script>

            <!-- Список донатов -->
            {% if donations %}
            <h3 class="donations-title">Переводы</h3>
            {% for d in donations %}
            <div class="donation-item">
                <div class="donation-avatar">🐱</div>
                <div class="donation-info">
                    <div class="donor-name">{{ d.donor_name or 'Аноним' }}</div>
                    <div class="donor-meta">
                        {% if d.status == 'donor_confirmed' %}ожидает
                        {% elif d.status == 'recipient_confirmed' %}подтверждён
                        {% elif d.status == 'completed' %}засчитан
                        {% else %}{{ d.status }}{% endif %}
                    </div>
                    {% if d.warm_word %}
                    <div class="warm-word">«{{ d.warm_word }}»</div>
                    {% endif %}
                </div>
                <div class="donation-amount">{{ "%.0f"|format(d.amount_reported) }} ₽</div>
                {% if is_author and d.status == 'donor_confirmed' %}
                <form method="POST" action="/confirm/{{ d.id }}" style="margin:0;">
                    <button type="submit" class="confirm-btn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5B9A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" stroke="white"></polyline></svg> Подтверждаю</button>
                </form>
                {% endif %}
            </div>
            {% endfor %}
            {% endif %}

            <!-- Кнопка назад -->
            <a class="btn-back" href="/goals" style="text-align:center;">Лента целей</a>
            {% if user and not is_author and not already_reported %}
            <a class="btn-back" onclick="openReportModal()" style="text-align:center;cursor:pointer;">Пожаловаться</a>
            {% endif %}
        </div>
    </div>

    <!-- Модальное окно помощи -->
    <div class="modal" id="donateModal">
        <div class="modal-content" id="donateContent">

            <!-- ШАГ 1: Выбор суммы + тёплое слово + анонимность -->
            <div id="donateStep1">
                <span class="modal-close" onclick="closeModal()">×</span>
                <h3 class="modal-title">Выберите сумму</h3>

                <button class="amount-btn" onclick="selectAmount(100, event)">100 ₽</button>
                <button class="amount-btn" onclick="selectAmount(500, event)">500 ₽</button>
                <button class="amount-btn" onclick="selectAmount(1000, event)">1 000 ₽</button>

                <div id="warmWordBlock" style="display:none;margin-top:12px;">
                    <input type="text" id="warmWordInput" maxlength="200" placeholder="Тёплое слово получателю (необязательно)" style="width:100%;padding:12px 14px;border:1px solid #E0E0E0;border-radius:12px;font-size:14px;box-sizing:border-box;margin-bottom:12px;">
                    <label class="anon-check-wrap">
                        <input type="checkbox" id="anonymousCheck">
                        <span class="anon-check-box"></span>
                        <span class="anon-check-label">Помочь анонимно</span>
                    </label>
                </div>

                <button class="donate-submit" id="donateSubmit" onclick="startDonate()">Помочь <span id="selectedAmount"></span> ₽</button>
            </div>

            <!-- ШАГ 2: Реквизиты (Plan Б) -->
            <div id="donateStep2" style="display:none;">
                <span class="modal-close" onclick="closeModal()">×</span>
                <h3 class="modal-title">Переведите по реквизитам</h3>

                <div class="row">
                    <span class="label">Номер</span>
                    <div class="value-wrap">
                        <span class="value" id="phoneValue">{{ author.phone }}</span>
                        <button class="copy-btn" id="copyPhoneBtn" style="background:none;border:none;padding:6px;cursor:pointer;display:flex;align-items:center;" onclick="copyPhone(this)"><i data-feather="copy" style="color:#8C7A6B;width:18px;height:18px;"></i></button>
                    </div>
                </div>
                <div class="row">
                    <span class="label">Сумма</span>
                    <span class="value" id="manualAmount">—</span>
                </div>
                <div class="row">
                    <span class="label">Комментарий</span>
                    <span class="value">Благотворительный подарок</span>
                </div>

                <form method="POST" action="/donate/{{ goal.id }}" id="confirmForm" style="display:none;">
                    <input type="hidden" name="amount" id="confirmAmount">
                    <input type="hidden" name="warm_word" id="confirmWarmWord">
                    <input type="hidden" name="anonymous" id="confirmAnonymous">
                    <button type="submit" class="confirm-submit">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Я перевёл(ла)
                    </button>
                </form>
            </div>

        </div>
    </div>

    <script>
        var selectedAmount = 0;

        function openModal() {
            document.body.style.overflow = 'hidden';
            document.getElementById('donateModal').classList.add('active');
            // Сброс к Шагу 1
            document.getElementById('donateStep1').style.display = 'block';
            document.getElementById('donateStep2').style.display = 'none';
            document.getElementById('warmWordBlock').style.display = 'none';
            document.getElementById('anonymousCheck').checked = false;
            document.getElementById('confirmForm').style.display = 'none';
            selectedAmount = 0;
            document.getElementById('donateSubmit').classList.remove('active');
            document.querySelectorAll('.amount-btn').forEach(function(b) { b.classList.remove('selected'); });
            document.getElementById('warmWordInput').value = '';
        }

        function closeModal() {
            document.getElementById('donateModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function selectAmount(amount, event) {
            selectedAmount = amount;
            document.querySelectorAll('.amount-btn').forEach(function(b) { b.classList.remove('selected'); });
            event.target.classList.add('selected');
            document.getElementById('selectedAmount').textContent = amount;
            document.getElementById('donateSubmit').classList.add('active');
            document.getElementById('warmWordBlock').style.display = 'block';
            document.getElementById('donateSubmit').focus();
            document.getElementById('warmWordBlock').style.animation = 'fadeInUp 0.3s ease forwards';
            document.getElementById('manualAmount').textContent = amount + ' ₽';
            document.getElementById('confirmAmount').value = amount;
        }

        function copyPhone(btn) {
            var phone = document.getElementById('phoneValue').textContent;
            var t = document.createElement('textarea');
            t.value = phone;
            t.style.position = 'fixed';
            t.style.left = '-9999px';
            document.body.appendChild(t);
            t.select();
            try { document.execCommand('copy'); } catch(e) {}
            document.body.removeChild(t);

            btn.style.transition = 'all 0.2s';
            btn.style.transform = 'scale(0.8)';
            setTimeout(function() {
                btn.innerHTML = '<i data-feather="check" style="color:#5B9A6B;"></i>';
                feather.replace();
                btn.style.transform = 'scale(1)';
            }, 150);
            setTimeout(function() {
                btn.style.transform = 'scale(0.8)';
                setTimeout(function() {
                    btn.innerHTML = '<i data-feather="copy" style="color:#8C7A6B;"></i>';
                    feather.replace();
                    btn.style.transform = 'scale(1)';
                }, 150);
            }, 1500);

            // Показываем форму подтверждения
            var form = document.getElementById('confirmForm');
            form.style.display = 'block';
            form.querySelector('button').focus();
        }

        function startDonate() {
            if (!selectedAmount) return;
            // Переключаемся на Шаг 2
            document.getElementById('donateStep1').style.display = 'none';
            document.getElementById('donateStep2').style.display = 'block';
            // Сохраняем тёплое слово и анонимность
            document.getElementById('confirmWarmWord').value = document.getElementById('warmWordInput').value;
            var anon = document.getElementById('anonymousCheck').checked;
            document.getElementById('confirmAnonymous').value = anon ? '1' : '0';
        }

        document.getElementById('confirmForm').addEventListener('submit', function() {
            document.getElementById('confirmWarmWord').value = document.getElementById('warmWordInput').value;
            var anon = document.getElementById('anonymousCheck').checked;
            document.getElementById('confirmAnonymous').value = anon ? '1' : '0';
        });

        document.getElementById('donateModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    // Галерея фото
    (function() {
        var gallery = document.getElementById('gallery');
        if (!gallery) return;

        // === Защита фото от долгого тапа и копирования ===
        (function() {
            var protectedTargets = document.querySelectorAll('.gallery-hero, .gallery-thumb, .lightbox');

            protectedTargets.forEach(function(el) {
                // Запрет контекстного меню (правый клик, долгий тап на Android)
                el.addEventListener('contextmenu', function(e) { e.preventDefault(); });

                // Долгий тап — блокируем меню
                var longPressTimer = null;
                el.addEventListener('touchstart', function(e) {
                    longPressTimer = setTimeout(function() {
                        if (e.cancelable) e.preventDefault();
                    }, 500);
                }, { passive: false });
                el.addEventListener('touchend', function() {
                    clearTimeout(longPressTimer);
                });
                el.addEventListener('touchmove', function() {
                    clearTimeout(longPressTimer);
                });
                el.addEventListener('touchcancel', function() {
                    clearTimeout(longPressTimer);
                });

                // Блокировка drag
                el.addEventListener('dragstart', function(e) { e.preventDefault(); });
            });

            // Блокировка горячих клавиш: PrintScreen, Ctrl+S, Ctrl+Shift+S, Cmd+Shift+3/4
            document.addEventListener('keydown', function(e) {
                // PrintScreen
                if (e.key === 'PrintScreen') {
                    e.preventDefault();
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(''); // чистим буфер
                    }
                    return false;
                }
                // Ctrl+S / Cmd+S — сохранить страницу
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    return false;
                }
                // Ctrl+Shift+S — сохранить как
                if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    return false;
                }
                // Cmd+Shift+3/4 (macOS скриншот)
                if (e.metaKey && e.shiftKey && (e.key === '3' || e.key === '4')) {
                    e.preventDefault();
                    return false;
                }
            });

            // Размытие при потере фокуса (ловит Snipping Tool, Lightshot и др.)
            var blurTimer = null;
            window.addEventListener('blur', function() {
                blurTimer = setTimeout(function() {
                    if (document.hasFocus && !document.hasFocus()) {
                        gallery.style.filter = 'blur(20px)';
                        gallery.style.transition = 'filter 0.2s';
                    }
                }, 100);
            });
            window.addEventListener('focus', function() {
                clearTimeout(blurTimer);
                gallery.style.filter = '';
            });

            // Размытие при visibilitychange (переключение вкладок)
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    gallery.style.filter = 'blur(20px)';
                } else {
                    gallery.style.filter = '';
                }
            });
        })();
        // === Конец защиты ===
        var photos = JSON.parse(gallery.dataset.photos);
        var currentIndex = 0;

        window.selectPhoto = function(index) {
            currentIndex = index;
            var hero = document.getElementById('galleryHero');
            hero.style.backgroundImage = 'url(' + photos[index] + ')';
            var counter = document.getElementById('galleryCounter');
            if (counter) counter.textContent = (index + 1) + ' / ' + photos.length;
            document.querySelectorAll('.gallery-thumb').forEach(function(t, i) {
                t.classList.toggle('active', i === index);
            });
        };

        window.openLightbox = function(index) {
            currentIndex = index;
            var lb = document.getElementById('lightbox');
            if (!lb) {
                lb = document.createElement('div');
                lb.className = 'lightbox';
                lb.id = 'lightbox';
                lb.innerHTML = '<button class="lightbox-close" onclick="closeLightbox()">×</button>' +
                    (photos.length > 1 ? '<button class="lightbox-nav lightbox-prev" onclick="lbNav(-1)">‹</button><button class="lightbox-nav lightbox-next" onclick="lbNav(1)">›</button>' : '') +
                    '<div class="lightbox-img-wrap"><div id="lightboxImg" class="lightbox-img-view"></div></div>' +
                    (photos.length > 1 ? '<div class="lightbox-counter" id="lightboxCounter"></div>' : '');
                document.body.appendChild(lb);
                lb.addEventListener('click', function(e) {
                    if (e.target === lb) closeLightbox();
                });
                // Защита от контекстного меню внутри лайтбокса
                lb.addEventListener('contextmenu', function(e) { e.preventDefault(); });
                lb.addEventListener('dragstart', function(e) { e.preventDefault(); });
                // Долгий тап в лайтбоксе
                var lbLongPress = null;
                lb.addEventListener('touchstart', function(e) {
                    lbLongPress = setTimeout(function() {
                        if (e.cancelable) e.preventDefault();
                    }, 500);
                }, { passive: false });
                lb.addEventListener('touchend', function() { clearTimeout(lbLongPress); });
                lb.addEventListener('touchmove', function() { clearTimeout(lbLongPress); });
                lb.addEventListener('touchcancel', function() { clearTimeout(lbLongPress); });
            }
            document.getElementById('lightboxImg').style.backgroundImage = 'url(' + photos[currentIndex] + ')';
            var lc = document.getElementById('lightboxCounter');
            if (lc) lc.textContent = (currentIndex + 1) + ' / ' + photos.length;
            document.body.style.overflow = 'hidden';
            lb.classList.add('active');
        };

        window.closeLightbox = function() {
            var lb = document.getElementById('lightbox');
            if (lb) lb.classList.remove('active');
            document.body.style.overflow = '';
        };

        window.lbNav = function(delta) {
            currentIndex = (currentIndex + delta + photos.length) % photos.length;
            document.getElementById('lightboxImg').style.backgroundImage = 'url(' + photos[currentIndex] + ')';
            var lc = document.getElementById('lightboxCounter');
            if (lc) lc.textContent = (currentIndex + 1) + ' / ' + photos.length;
            selectPhoto(currentIndex);
        };

        // Свайп на мобильных
        var touchStartX = 0;
        document.addEventListener('touchstart', function(e) {
            if (e.target.closest('.lightbox')) touchStartX = e.touches[0].clientX;
        });
        document.addEventListener('touchend', function(e) {
            if (!e.target.closest('.lightbox')) return;
            var delta = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(delta) > 50) lbNav(delta > 0 ? -1 : 1);
        });

        // Стрелки клавиатуры
        document.addEventListener('keydown', function(e) {
            var lb = document.getElementById('lightbox');
            if (!lb || !lb.classList.contains('active')) return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') lbNav(-1);
            if (e.key === 'ArrowRight') lbNav(1);
        });
    })();

    feather.replace();
</script>
<script src="/static/toast.js"></script>
</body>
</html>