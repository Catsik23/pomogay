<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создать цель — помогай.рф</title>
    <link rel="stylesheet" href="/static/style.css?v=3">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', -apple-system, sans-serif; background: #FDF8F5; color: #2D2D2D; }
        .container { max-width: 500px; margin: 0 auto; padding: 20px; }
        h1 { color: #FF6B4A; font-size: 28px; margin-bottom: 10px; }
        .goal-type { color: #8C7A6B; font-size: 14px; margin-bottom: 24px; }
        label { display: block; margin: 16px 0 6px; color: #8C7A6B; font-size: 14px; }
        input, textarea, select {
            width: 100%;
            padding: 14px;
            border: 1px solid #E0E0E0;
            border-radius: 14px;
            font-size: 16px;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus, textarea:focus, select:focus { border-color: #FF6B4A; }
        textarea { resize: vertical; min-height: 80px; }
        button {
            width: 100%;
            padding: 16px;
            background: linear-gradient(160deg, #FF5A3C 0%, #FF7B5C 35%, #E85D75 100%);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            transition: transform 0.1s, box-shadow 0.2s;
            box-shadow: 0 2px 8px rgba(255,107,74,0.12);
        }
        button:active { transform: scale(0.97); }
        .flash { padding: 10px; margin-bottom: 10px; border-radius: 10px; font-size: 14px; }
        .flash-success { background: #d4edda; color: #155724; }
        .flash-danger { background: #f8d7da; color: #721c24; }
        .flash-warning { background: #fff3cd; color: #856404; }
        .back { display: block; margin-top: 15px; text-align: center; color: #8C7A6B; font-size: 14px; }
        .back a { color: #FF6B4A; text-decoration: none; }
        .hint { font-size: 12px; color: #999; margin-top: 4px; }
        input[type="file"] { padding: 10px; }

        /* Кнопка Правила */
        .rules-btn {
            background: none;
            border: 1px solid #E0E0E0;
            color: #8C7A6B;
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            margin-left: 8px;
            vertical-align: middle;
        }
        .rules-btn:active { background: #F5F5F5; }

        /* Модалка правил */
        .rules-modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.4);
            z-index: 100;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .rules-modal.active { display: flex; }
        .rules-content {
            background: white;
            border-radius: 20px;
            padding: 24px;
            max-width: 420px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
        }
        .rules-content h2 {
            font-size: 20px;
            margin-bottom: 16px;
            color: #2D2D2D;
        }
        .rules-content ol {
            padding-left: 20px;
            margin-bottom: 20px;
        }
        .rules-content li {
            font-size: 15px;
            line-height: 1.5;
            color: #2D2D2D;
            margin-bottom: 12px;
        }
        .rules-content li span {
            color: #8C7A6B;
            font-size: 13px;
            display: block;
            margin-top: 2px;
        }
        .rules-close {
            width: 100%;
            padding: 14px;
            background: #5B9A6B;
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }
        .rules-close:active { transform: scale(0.97); }

        /* Плашка ошибки */
        .field-error {
            display: none;
            background: #FFF3CD;
            color: #856404;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 14px;
            margin-top: 8px;
            border-left: 3px solid #FFA726;
        }
        .field-error.active { display: block; }

        /* Подсветка проблемного слова */
        .highlight-box {
            display: none;
            background: #FDF8F5;
            border: 1px solid #E0E0E0;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 14px;
            margin-top: 8px;
            color: #2D2D2D;
            line-height: 1.5;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .highlight-box.active { display: block; }
        .highlight-box mark {
            background: #FFE0B2;
            color: #E65100;
            padding: 1px 3px;
            border-radius: 4px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Создать цель</h1>
        <div class="goal-type">
            {% if goal_type == 'super_blitz' %}Супер-блиц — до 5 000 ₽ на 1 день{% else %}Блиц — до 50 000 ₽ на 1–7 дней{% endif %}
        </div>

        <script id="toast-data" type="application/json">[{% with messages = get_flashed_messages(with_categories=true) %}{% if messages %}{% for category, message in messages %}{"category":"{{ category }}","text":"{{ message|replace('"', '\"') }}"}{% if not loop.last %},{% endif %}{% endfor %}{% endif %}{% endwith %}]</script>

        <form method="POST" enctype="multipart/form-data">
            <label>Название цели *</label>
            <div class="field-error" id="titleError"></div>
            <input type="text" name="title" id="titleField" maxlength="140" placeholder="" value="{{ title or '' }}" required autofocus>
            <div class="hint">До 140 символов</div>

            <label>Описание <button type="button" class="rules-btn" onclick="openRules()">Правила</button></label>
            <div class="field-error" id="descError"></div>
            <div class="highlight-box" id="descHighlight"></div>
            <textarea name="description" id="descField" maxlength="1000" placeholder="">{{ description or '' }}</textarea>
            <div class="hint">Опишите ситуацию — это повышает доверие</div>

            <label>Сумма (₽) *</label>
            <input type="number" name="amount" placeholder="" value="{{ amount or '' }}" min="{% if goal_type == 'super_blitz' %}100{% else %}500{% endif %}" max="{% if goal_type == 'super_blitz' %}5000{% else %}50000{% endif %}" required>
            <div class="hint">{% if goal_type == 'super_blitz' %}От 100 до 5 000 ₽{% else %}От 500 до 50 000 ₽{% endif %}</div>

            <label>Срок (дней) *</label>
            <select name="days" required>
                <option value="">Выберите срок</option>
                {% if goal_type == 'super_blitz' %}
                <option value="1" {% if days == '1' %}selected{% endif %}>1 день</option>
                {% else %}
                <option value="1" {% if days == '1' %}selected{% endif %}>1 день</option>
                <option value="3" {% if days == '3' %}selected{% endif %}>3 дня</option>
                <option value="7" {% if days == '7' %}selected{% endif %}>7 дней</option>
                {% endif %}
            </select>

            <label>Фото (опционально)</label>
            <input type="file" name="photo" accept="image/*">
            <div class="hint">Фото, скрин или документ — повышает доверие</div>

            <button type="submit" class="btn-cta">Создать цель</button>
        </form>
        <div class="back"><a class="btn-back" href="/goals/choose">← Выбрать другой тип</a></div>
    </div>

    <!-- Модалка правил -->
    <div class="rules-modal" id="rulesModal">
        <div class="rules-content">
            <h2>Правила описания</h2>
            <ol>
                <li>Без ссылок. Совсем.<span>Даже на «свой VK». Даже на «подробности тут».<br>Мы не пропускаем ссылки, чтобы защитить тех, кто тебе помогает.</span></li>
                <li>Без телефонов и ников из мессенджеров.<span>В описании цели для контактов места нет.</span></li>
                <li>Без упоминания запрещённых в РФ организаций.<span>Даже в шутку. Даже «просто спросить».<br>Мы работаем по закону РФ. Это не обсуждается.</span></li>
                <li>Без хамства и мата.<span>Здесь собрались люди — говори по-человечески.</span></li>
                <li>Будь честен.<span>Успех сбора зависит только от твоей искренности.<br>Не сдерживайся, но старайся быть ближе к сути.</span></li>
            </ol>
            <button type="button" class="rules-close" onclick="closeRules()">Закрыть</button>
        </div>
    </div>

    <script>
        function openRules() {
            document.getElementById('rulesModal').classList.add('active');
        }
        function closeRules() {
            document.getElementById('rulesModal').classList.remove('active');
        }
        document.getElementById('rulesModal').addEventListener('click', function(e) {
            if (e.target === this) closeRules();
        });

        // Живая валидация при уходе из поля
        async function liveCheck(fieldId, context, errorBoxId, highlightBoxId) {
            var field = document.getElementById(fieldId);
            var errBox = document.getElementById(errorBoxId);
            var text = field.value.trim();
            if (!text) {
                errBox.classList.remove('active');
                if (highlightBoxId) document.getElementById(highlightBoxId).classList.remove('active');
                return;
            }
            try {
                var resp = await fetch('/api/guard-check', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({text: text, context: context})
                });
                var data = await resp.json();
                if (data.status === 'blocked') {
                    errBox.textContent = data.message;
                    errBox.classList.add('active');
                    if (data.position) {
                        field.focus();
                        field.setSelectionRange(data.position[0], data.position[1]);
                    }
                } else if (data.status === 'flagged') {
                    errBox.textContent = 'Текст отправится на проверку';
                    errBox.classList.add('active');
                } else {
                    errBox.classList.remove('active');
                }
            } catch(e) {
                // Молча игнорируем сетевые ошибки
            }
        }

        document.getElementById('titleField').addEventListener('blur', function() {
            liveCheck('titleField', 'goal_title', 'titleError', null);
        });
        document.getElementById('descField').addEventListener('blur', function() {
            liveCheck('descField', 'goal_description', 'descError', 'descHighlight');
        });

        {% if error_field == 'title' %}
        (function() {
            var errBox = document.getElementById('titleError');
            errBox.textContent = {{ error_message|tojson }};
            errBox.classList.add('active');
            document.getElementById('titleField').focus();
        })();
        {% elif error_field == 'description' and error_text %}
        (function() {
            var pos = {{ error_position|tojson }};
            var desc = document.getElementById('descField').value;
            if (desc && pos) {
                var before = desc.substring(0, pos[0]);
                var marked = desc.substring(pos[0], pos[1]);
                var after = desc.substring(pos[1]);
                var highlighted = before + '<mark>' + marked + '</mark>' + after;
                var box = document.getElementById('descHighlight');
                box.innerHTML = highlighted;
                box.classList.add('active');
            }
            var errBox = document.getElementById('descError');
            errBox.textContent = {{ error_message|tojson }};
            errBox.classList.add('active');
        })();
        {% endif %}
    </script>
<script src="/static/toast.js"></script>
</body>
</html>